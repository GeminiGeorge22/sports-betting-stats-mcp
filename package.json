{
  "name": "sports-betting-stats-mcp",
  "version": "0.2.0",
  "description": "Stdio MCP server: sports betting stats: sportsbook odds, player props, scores, xg, closing lines, horse racing via Apify's hosted MCP gateway",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sports-betting-stats-mcp": "src/server.js"
  },
  "main": "src/proxy.js",
  "files": [
    "src",
    "tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/proxy.test.js",
    "build:tools": "node scripts/build-tools.mjs",
    "check:tools": "node scripts/build-tools.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeminiGeorge22/sports-betting-stats-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apify",
    "sports-betting",
    "sports-odds",
    "sports-data",
    "player-props",
    "betting"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "mcpProxy": {
    "actors": [
      "publicrecords/sports-odds-api",
      "scrapemint/sports-odds-scraper",
      "zen-studio/prizepicks-player-props",
      "sports-odds-lab/football-odds-results",
      "hgservices/apify-actor-espn",
      "constructive_calm/understat-football-analytics",
      "jungle_synthesizer/equibase-us-horse-racing-scraper",
      "congism/polymarket-kalshi-arb-finder"
    ]
  }
}
